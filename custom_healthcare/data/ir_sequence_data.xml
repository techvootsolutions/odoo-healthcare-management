<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_healthcare_patient" model="ir.sequence">
        <field name="name">Healthcare Patient</field>
        <field name="code">healthcare.patient</field>
        <field name="prefix">PAT/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_healthcare_lab_request" model="ir.sequence">
        <field name="name">Healthcare Lab Request</field>
        <field name="code">healthcare.lab.request</field>
        <field name="prefix">LAB/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_healthcare_prescription" model="ir.sequence">
        <field name="name">Healthcare Prescription</field>
        <field name="code">healthcare.prescription</field>
        <field name="prefix">RX/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_healthcare_admission" model="ir.sequence">
        <field name="name">Healthcare Admission</field>
        <field name="code">healthcare.admission</field>
        <field name="prefix">ADM/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
