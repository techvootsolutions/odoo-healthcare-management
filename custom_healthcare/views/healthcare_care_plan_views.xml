<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_healthcare_care_plan_list" model="ir.ui.view">
        <field name="name">healthcare.care.plan.list</field>
        <field name="model">healthcare.care.plan</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="patient_id"/>
                <field name="disease_id"/>
                <field name="coordinator_id"/>
                <field name="start_date"/>
                <field name="compliance_rate"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_healthcare_care_plan_form" model="ir.ui.view">
        <field name="name">healthcare.care.plan.form</field>
        <field name="model">healthcare.care.plan</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_activate" type="object" string="Activate &amp; Generate Tasks"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_complete" type="object" string="Complete"
                            invisible="state != 'active'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,completed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_overdue_lines" type="object" class="oe_stat_button" icon="fa-exclamation-triangle">
                            <field name="overdue_line_count" widget="statinfo" string="Overdue"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Care Plan Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="patient_id"/>
                            <field name="practice_id"/>
                            <field name="disease_id"/>
                            <field name="coordinator_id"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="compliance_rate" widget="progressbar"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="goal"/>
                    <notebook>
                        <page string="Activities">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="activity_type"/>
                                    <field name="frequency"/>
                                    <field name="responsible_id"/>
                                    <field name="next_due_date"/>
                                    <field name="state"/>
                                    <button name="action_mark_done" type="object" string="Done"
                                            icon="fa-check"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_healthcare_care_plan_line_list" model="ir.ui.view">
        <field name="name">healthcare.care.plan.line.list</field>
        <field name="model">healthcare.care.plan.line</field>
        <field name="arch" type="xml">
            <list>
                <field name="next_due_date"/>
                <field name="name"/>
                <field name="care_plan_id"/>
                <field name="activity_type"/>
                <field name="responsible_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_healthcare_care_plan_line_form" model="ir.ui.view">
        <field name="name">healthcare.care.plan.line.form</field>
        <field name="model">healthcare.care.plan.line</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_mark_done" type="object" string="Mark Done"
                            class="oe_highlight" invisible="state == 'done'"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,scheduled,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Activity Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="care_plan_id"/>
                            <field name="activity_type"/>
                            <field name="frequency"/>
                            <field name="responsible_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="next_due_date"/>
                            <field name="last_done_date"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Notes..."/>
                    <notebook>
                        <page string="Activities">
                            <field name="activity_ids">
                                <list editable="bottom">
                                    <field name="activity_type_id"/>
                                    <field name="summary"/>
                                    <field name="date_deadline"/>
                                    <field name="user_id"/>
                                    <field name="state" widget="badge"
                                           decoration-danger="state == 'overdue'"
                                           decoration-warning="state == 'today'"
                                           decoration-success="state == 'planned'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_healthcare_care_plan_line_search" model="ir.ui.view">
        <field name="name">healthcare.care.plan.line.search</field>
        <field name="model">healthcare.care.plan.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="care_plan_id"/>
                <filter string="Overdue" name="overdue"
                        domain="[('next_due_date', '&lt;', context_today().strftime('%Y-%m-%d')), ('state', 'in', ['pending', 'scheduled', 'overdue'])]"/>
                <filter string="Today" name="today"
                        domain="[('next_due_date', '=', context_today().strftime('%Y-%m-%d'))]"/>
            </search>
        </field>
    </record>

    <record id="action_healthcare_care_plan" model="ir.actions.act_window">
        <field name="name">Care Plans</field>
        <field name="res_model">healthcare.care.plan</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_healthcare_care_plan_line" model="ir.actions.act_window">
        <field name="name">Follow-up Activities</field>
        <field name="res_model">healthcare.care.plan.line</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_healthcare_overdue_followups" model="ir.actions.act_window">
        <field name="name">Overdue Follow-ups</field>
        <field name="res_model">healthcare.care.plan.line</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', 'in', ['pending', 'scheduled', 'overdue'])]</field>
        <field name="context">{'search_default_overdue': 1}</field>
    </record>
</odoo>
