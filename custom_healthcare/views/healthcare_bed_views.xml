<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_healthcare_bed_list" model="ir.ui.view">
        <field name="name">healthcare.bed.list</field>
        <field name="model">healthcare.bed</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="ward_id"/>
                <field name="room_id"/>
                <field name="practice_id"/>
                <field name="bed_type"/>
                <field name="status" decoration-success="status == 'available'"
                       decoration-danger="status == 'occupied'"
                       decoration-warning="status in ('cleaning', 'maintenance')"
                       decoration-muted="status == 'blocked'"/>
                <field name="current_patient_id"/>
                <field name="daily_rate"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_healthcare_bed_form" model="ir.ui.view">
        <field name="name">healthcare.bed.form</field>
        <field name="model">healthcare.bed</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_mark_available" type="object" string="Mark Available"
                            invisible="status not in ('cleaning', 'maintenance', 'blocked')" class="oe_highlight"/>
                    <button name="action_mark_maintenance" type="object" string="Send to Maintenance"
                            invisible="status not in ('available', 'cleaning')"/>
                    <button name="action_block" type="object" string="Block"
                            invisible="status == 'blocked'"/>
                    <field name="status" widget="statusbar"
                           statusbar_visible="available,reserved,occupied,cleaning,maintenance"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Bed Name/Number"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="room_id"/>
                            <field name="ward_id" readonly="1"/>
                            <field name="practice_id" readonly="1"/>
                            <field name="bed_type"/>
                        </group>
                        <group>
                            <field name="current_patient_id" readonly="1"/>
                            <field name="daily_rate"/>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_healthcare_bed_kanban" model="ir.ui.view">
        <field name="name">healthcare.bed.kanban</field>
        <field name="model">healthcare.bed</field>
        <field name="arch" type="xml">
            <kanban default_group_by="status" class="o_kanban_small_column">
                <field name="status"/>
                <field name="current_patient_id"/>
                <templates>
                    <t t-name="card">
                        <field name="display_name" class="fw-bold"/>
                        <div t-if="record.current_patient_id.raw_value" class="text-muted">
                            <field name="current_patient_id"/>
                        </div>
                        <footer>
                            <field name="bed_type"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_healthcare_bed_search" model="ir.ui.view">
        <field name="name">healthcare.bed.search</field>
        <field name="model">healthcare.bed</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="ward_id"/>
                <field name="room_id"/>
                <field name="practice_id"/>
                <filter string="Available" name="available" domain="[('status', '=', 'available')]"/>
                <filter string="Occupied" name="occupied" domain="[('status', '=', 'occupied')]"/>
                <filter string="Needs Attention" name="needs_attention"
                        domain="[('status', 'in', ['cleaning', 'maintenance', 'blocked'])]"/>
                <group>
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                    <filter string="Ward" name="group_ward" context="{'group_by': 'ward_id'}"/>
                    <filter string="Practice" name="group_practice" context="{'group_by': 'practice_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_healthcare_bed" model="ir.actions.act_window">
        <field name="name">Bed Board</field>
        <field name="res_model">healthcare.bed</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_group_status': 1}</field>
    </record>
</odoo>
