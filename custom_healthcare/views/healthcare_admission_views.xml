<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_healthcare_admission_list" model="ir.ui.view">
        <field name="name">healthcare.admission.list</field>
        <field name="model">healthcare.admission</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="patient_id"/>
                <field name="practice_id"/>
                <field name="bed_id"/>
                <field name="admission_type"/>
                <field name="admission_date"/>
                <field name="expected_discharge_date"/>
                <field name="length_of_stay"/>
                <field name="state"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_healthcare_admission_form" model="ir.ui.view">
        <field name="name">healthcare.admission.form</field>
        <field name="model">healthcare.admission</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_admit" type="object" string="Admit"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_open_transfer_wizard" type="object" string="Transfer Bed"
                            invisible="state != 'admitted'"/>
                    <button name="action_discharge" type="object" string="Discharge"
                            invisible="state != 'admitted'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state not in ('draft', 'admitted')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,admitted,discharged"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="patient_id"/>
                            <field name="practice_id"/>
                            <field name="bed_id" domain="[('practice_id', '=', practice_id), ('status', '=', 'available')]"
                                   readonly="state != 'draft'"/>
                            <field name="admission_type"/>
                            <field name="admitting_physician_id"/>
                        </group>
                        <group>
                            <field name="admission_date"/>
                            <field name="expected_discharge_date"/>
                            <field name="actual_discharge_date" readonly="1"/>
                            <field name="length_of_stay"/>
                            <field name="estimated_charges"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Clinical">
                            <group>
                                <field name="admission_reason"/>
                                <field name="diagnosis"/>
                            </group>
                        </page>
                        <page string="Discharge" invisible="state not in ('admitted', 'discharged')">
                            <group>
                                <field name="discharge_condition"/>
                                <field name="discharge_summary"/>
                            </group>
                        </page>
                        <page string="Bed Transfers">
                            <field name="transfer_ids" readonly="1">
                                <list>
                                    <field name="transfer_date"/>
                                    <field name="from_bed_id"/>
                                    <field name="to_bed_id"/>
                                    <field name="transferred_by"/>
                                    <field name="reason"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_healthcare_admission_search" model="ir.ui.view">
        <field name="name">healthcare.admission.search</field>
        <field name="model">healthcare.admission</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="patient_id"/>
                <field name="bed_id"/>
                <field name="practice_id"/>
                <filter string="Admitted" name="admitted" domain="[('state', '=', 'admitted')]"/>
                <filter string="Discharge Overdue" name="discharge_overdue"
                        domain="[('state', '=', 'admitted'), ('expected_discharge_date', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <group>
                    <filter string="Practice" name="group_practice" context="{'group_by': 'practice_id'}"/>
                    <filter string="Ward" name="group_ward" context="{'group_by': 'ward_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_healthcare_admission" model="ir.actions.act_window">
        <field name="name">Admissions</field>
        <field name="res_model">healthcare.admission</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_admitted': 1}</field>
    </record>
</odoo>
