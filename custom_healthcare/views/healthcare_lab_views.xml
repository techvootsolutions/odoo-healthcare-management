<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_healthcare_lab_test_type_list" model="ir.ui.view">
        <field name="name">healthcare.lab.test.type.list</field>
        <field name="model">healthcare.lab.test.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="category"/>
                <field name="default_unit"/>
                <field name="reference_range"/>
            </list>
        </field>
    </record>

    <record id="view_healthcare_lab_test_type_form" model="ir.ui.view">
        <field name="name">healthcare.lab.test.type.form</field>
        <field name="model">healthcare.lab.test.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="category"/>
                        <field name="default_unit"/>
                        <field name="reference_range"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_healthcare_lab_request_list" model="ir.ui.view">
        <field name="name">healthcare.lab.request.list</field>
        <field name="model">healthcare.lab.request</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="request_date"/>
                <field name="patient_id"/>
                <field name="practice_id"/>
                <field name="priority"/>
                <field name="abnormal_count"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_healthcare_lab_request_form" model="ir.ui.view">
        <field name="name">healthcare.lab.request.form</field>
        <field name="model">healthcare.lab.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_request" type="object" string="Submit Request"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_in_progress" type="object" string="Start Processing"
                            invisible="state != 'requested'"/>
                    <button name="action_complete" type="object" string="Complete"
                            class="oe_highlight" invisible="state not in ('requested', 'in_progress')"/>
                    <field name="state" widget="statusbar"
                            statusbar_visible="draft,requested,in_progress,completed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_abnormal_lines" type="object" class="oe_stat_button" icon="fa-exclamation-triangle">
                            <field name="abnormal_count" widget="statinfo" string="Abnormal"/>
                        </button>
                        <button name="action_view_pending_review_lines" type="object" class="oe_stat_button" icon="fa-eye">
                            <field name="pending_review_count" widget="statinfo" string="Pending Review"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="patient_id"/>
                            <field name="practice_id"/>
                            <field name="consultation_id"/>
                            <field name="requested_by_id"/>
                        </group>
                        <group>
                            <field name="request_date"/>
                            <field name="priority"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="clinical_notes"/>
                    <notebook>
                        <page string="Tests &amp; Results">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="test_type_id"/>
                                    <field name="result_value"/>
                                    <field name="result_unit"/>
                                    <field name="reference_range"/>
                                    <field name="is_abnormal"/>
                                    <field name="result_date"/>
                                    <field name="review_state"/>
                                    <button name="action_mark_reviewed" type="object"
                                            string="Reviewed" icon="fa-check"
                                            invisible="review_state != 'pending'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_healthcare_lab_request_line_list" model="ir.ui.view">
        <field name="name">healthcare.lab.request.line.list</field>
        <field name="model">healthcare.lab.request.line</field>
        <field name="arch" type="xml">
            <list>
                <field name="patient_id"/>
                <field name="test_type_id"/>
                <field name="result_value"/>
                <field name="is_abnormal"/>
                <field name="review_state"/>
                <field name="request_id"/>
            </list>
        </field>
    </record>

    <record id="view_healthcare_lab_request_graph" model="ir.ui.view">
        <field name="name">healthcare.lab.request.graph</field>
        <field name="model">healthcare.lab.request</field>
        <field name="arch" type="xml">
            <graph string="Lab Requests" type="bar">
                <field name="state"/>
            </graph>
        </field>
    </record>

    <record id="action_healthcare_lab_test_type" model="ir.actions.act_window">
        <field name="name">Lab Test Types</field>
        <field name="res_model">healthcare.lab.test.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_healthcare_lab_request" model="ir.actions.act_window">
        <field name="name">Lab Requests</field>
        <field name="res_model">healthcare.lab.request</field>
        <field name="view_mode">list,form,graph</field>
    </record>

    <record id="action_healthcare_lab_abnormal" model="ir.actions.act_window">
        <field name="name">Abnormal Labs</field>
        <field name="res_model">healthcare.lab.request.line</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_abnormal', '=', True)]</field>
    </record>
</odoo>
