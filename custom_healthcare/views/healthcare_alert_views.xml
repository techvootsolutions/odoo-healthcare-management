<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_healthcare_alert_list" model="ir.ui.view">
        <field name="name">healthcare.alert.list</field>
        <field name="model">healthcare.alert</field>
        <field name="arch" type="xml">
            <list decoration-danger="priority == '3'" decoration-warning="priority == '2'">
                <field name="priority"/>
                <field name="name"/>
                <field name="patient_id"/>
                <field name="alert_type"/>
                <field name="responsible_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_healthcare_alert_form" model="ir.ui.view">
        <field name="name">healthcare.alert.form</field>
        <field name="model">healthcare.alert</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_acknowledge" type="object" string="Acknowledge"
                            invisible="state != 'open'"/>
                    <button name="action_resolve" type="object" string="Resolve" class="oe_highlight"
                            invisible="state in ('resolved', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="open,acknowledged,resolved"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="patient_id"/>
                            <field name="practice_id"/>
                            <field name="alert_type"/>
                        </group>
                        <group>
                            <field name="priority"/>
                            <field name="responsible_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="notes"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_healthcare_alert" model="ir.actions.act_window">
        <field name="name">CDS Alerts</field>
        <field name="res_model">healthcare.alert</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'open')]</field>
        <field name="context">{'search_default_open': 1}</field>
    </record>

    <record id="view_healthcare_population_report_list" model="ir.ui.view">
        <field name="name">healthcare.population.report.list</field>
        <field name="model">healthcare.population.report</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="patient_id"/>
                <field name="practice_id"/>
                <field name="age_band"/>
                <field name="gender"/>
                <field name="risk_level"/>
                <field name="active_care_plan_count"/>
                <field name="registry_count"/>
                <field name="care_gap_count"/>
                <field name="open_alert_count"/>
            </list>
        </field>
    </record>

    <record id="view_healthcare_population_report_pivot" model="ir.ui.view">
        <field name="name">healthcare.population.report.pivot</field>
        <field name="model">healthcare.population.report</field>
        <field name="arch" type="xml">
            <pivot string="Population Health">
                <field name="practice_id" type="row"/>
                <field name="risk_level" type="col"/>
                <field name="care_gap_count" type="measure"/>
                <field name="open_alert_count" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_healthcare_population_report_graph" model="ir.ui.view">
        <field name="name">healthcare.population.report.graph</field>
        <field name="model">healthcare.population.report</field>
        <field name="arch" type="xml">
            <graph string="Risk by Age Band" type="bar">
                <field name="age_band"/>
                <field name="risk_level"/>
            </graph>
        </field>
    </record>

    <record id="action_healthcare_population_report" model="ir.actions.act_window">
        <field name="name">Population Health Analytics</field>
        <field name="res_model">healthcare.population.report</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="context">{'pivot_measures': ['__count', 'care_gap_count', 'open_alert_count']}</field>
    </record>
</odoo>
