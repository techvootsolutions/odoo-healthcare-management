<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_healthcare_appointment_list" model="ir.ui.view">
        <field name="name">healthcare.appointment.list</field>
        <field name="model">healthcare.appointment</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'requested'"
                  decoration-success="state == 'completed'"
                  decoration-danger="state == 'no_show'"
                  decoration-muted="state in ('cancelled', 'rescheduled')">
                <field name="start"/>
                <field name="patient_id"/>
                <field name="appointment_type"/>
                <field name="practitioner_id" widget="many2one_avatar_user"/>
                <field name="practice_id"/>
                <field name="reason" optional="show"/>
                <field name="stop" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'requested'"
                       decoration-primary="state == 'scheduled'"
                       decoration-success="state == 'completed'"
                       decoration-danger="state == 'no_show'"
                       decoration-muted="state in ('cancelled', 'rescheduled')"/>
            </list>
        </field>
    </record>

    <record id="view_healthcare_appointment_form" model="ir.ui.view">
        <field name="name">healthcare.appointment.form</field>
        <field name="model">healthcare.appointment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm_request" type="object" string="Confirm Request"
                            class="oe_highlight" invisible="state != 'requested'"/>
                    <button name="action_reject_request" type="object" string="Reject"
                            invisible="state != 'requested'"/>
                    <button name="action_create_consultation" type="object" string="Start Consultation"
                            class="oe_highlight" invisible="state != 'scheduled' or consultation_id"/>
                    <button name="action_mark_completed" type="object" string="Mark Completed"
                            invisible="state != 'scheduled'"/>
                    <button name="action_mark_no_show" type="object" string="No Show"
                            invisible="state != 'scheduled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="requested,scheduled,completed"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="No Show" bg_color="text-bg-danger" invisible="state != 'no_show'"/>
                    <widget name="web_ribbon" title="Cancelled" bg_color="text-bg-secondary" invisible="state != 'cancelled'"/>
                    <div class="oe_title">
                        <label for="patient_id"/>
                        <h1><field name="patient_id" placeholder="Select patient..."/></h1>
                    </div>
                    <group>
                        <group string="Schedule">
                            <field name="start"/>
                            <field name="stop"/>
                            <field name="appointment_type"/>
                        </group>
                        <group string="Care Team">
                            <field name="practice_id"/>
                            <field name="practitioner_id" widget="many2one_avatar_user"/>
                            <field name="consultation_id" readonly="1" invisible="not consultation_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <field name="reason" placeholder="Reason for visit"/>
                    </group>
                    <notebook>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Internal notes for the care team..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_healthcare_appointment_calendar" model="ir.ui.view">
        <field name="name">healthcare.appointment.calendar</field>
        <field name="model">healthcare.appointment</field>
        <field name="arch" type="xml">
            <calendar string="Appointments"
                      date_start="start"
                      date_stop="stop"
                      color="practitioner_id"
                      mode="week"
                      event_open_popup="1"
                      quick_create="0"
                      hide_time="1">
                <field name="patient_id"/>
                <field name="appointment_type"/>
                <field name="practitioner_id" filters="1" avatar_field="avatar_128"/>
                <field name="practice_id" filters="1"/>
                <field name="state"/>
                <field name="reason"/>
            </calendar>
        </field>
    </record>

    <record id="view_healthcare_appointment_search" model="ir.ui.view">
        <field name="name">healthcare.appointment.search</field>
        <field name="model">healthcare.appointment</field>
        <field name="arch" type="xml">
            <search>
                <field name="patient_id"/>
                <field name="practitioner_id"/>
                <field name="practice_id"/>
                <field name="reason"/>
                <filter name="my_appointments" string="My Appointments"
                        domain="[('practitioner_id', '=', uid)]"/>
                <separator/>
                <filter name="today" string="Today"
                        domain="[('start', '&gt;=', datetime.datetime.combine(context_today(), datetime.time(0, 0))),
                                 ('start', '&lt;', datetime.datetime.combine(context_today() + relativedelta(days=1), datetime.time(0, 0)))]"/>
                <filter name="upcoming" string="Upcoming"
                        domain="[('start', '&gt;=', datetime.datetime.combine(context_today(), datetime.time(0, 0))),
                                 ('state', 'in', ['requested', 'scheduled'])]"/>
                <filter name="start" string="Date" date="start"/>
                <separator/>
                <filter name="requested" string="Requested Online" domain="[('state', '=', 'requested')]"/>
                <filter name="scheduled" string="Scheduled" domain="[('state', '=', 'scheduled')]"/>
                <filter name="completed" string="Completed" domain="[('state', '=', 'completed')]"/>
                <filter name="no_show" string="No Show" domain="[('state', '=', 'no_show')]"/>
                <filter name="cancelled" string="Cancelled" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter name="urgent" string="Urgent" domain="[('appointment_type', '=', 'urgent')]"/>
                <filter name="teleconsultation" string="Teleconsultation"
                        domain="[('appointment_type', '=', 'teleconsultation')]"/>
                <group>
                    <filter name="group_practitioner" string="Practitioner" context="{'group_by': 'practitioner_id'}"/>
                    <filter name="group_practice" string="Practice" context="{'group_by': 'practice_id'}"/>
                    <filter name="group_type" string="Type" context="{'group_by': 'appointment_type'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_day" string="Day" context="{'group_by': 'start:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_healthcare_appointment" model="ir.actions.act_window">
        <field name="name">Appointments</field>
        <field name="res_model">healthcare.appointment</field>
        <field name="view_mode">calendar,list,form</field>
        <field name="search_view_id" ref="view_healthcare_appointment_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Schedule the first appointment</p>
            <p>Book consultations, follow-ups and teleconsultations for your patients.</p>
        </field>
    </record>

    <record id="action_healthcare_appointment_requests" model="ir.actions.act_window">
        <field name="name">Appointment Requests</field>
        <field name="res_model">healthcare.appointment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'requested')]</field>
        <field name="search_view_id" ref="view_healthcare_appointment_search"/>
        <field name="context">{'default_state': 'requested'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No pending requests</p>
            <p>Appointments requested by patients through the portal appear here for confirmation.</p>
        </field>
    </record>
</odoo>
