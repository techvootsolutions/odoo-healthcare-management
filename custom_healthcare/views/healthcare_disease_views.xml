<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_healthcare_disease_type_list" model="ir.ui.view">
        <field name="name">healthcare.disease.type.list</field>
        <field name="model">healthcare.disease.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="category"/>
                <field name="patient_count"/>
            </list>
        </field>
    </record>

    <record id="view_healthcare_disease_type_form" model="ir.ui.view">
        <field name="name">healthcare.disease.type.form</field>
        <field name="model">healthcare.disease.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="category"/>
                        <field name="active"/>
                    </group>
                    <field name="description"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_healthcare_disease_registry_list" model="ir.ui.view">
        <field name="name">healthcare.disease.registry.list</field>
        <field name="model">healthcare.disease.registry</field>
        <field name="arch" type="xml">
            <list>
                <field name="patient_id"/>
                <field name="disease_id"/>
                <field name="practice_id"/>
                <field name="risk_level"/>
                <field name="next_review_date"/>
                <field name="compliance_state"/>
            </list>
        </field>
    </record>

    <record id="view_healthcare_disease_registry_form" model="ir.ui.view">
        <field name="name">healthcare.disease.registry.form</field>
        <field name="model">healthcare.disease.registry</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="patient_id"/>
                            <field name="disease_id"/>
                            <field name="practice_id"/>
                            <field name="care_plan_id"/>
                        </group>
                        <group>
                            <field name="enrolment_date"/>
                            <field name="risk_level"/>
                            <field name="last_review_date"/>
                            <field name="next_review_date"/>
                            <field name="compliance_state"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="notes"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_healthcare_disease_registry_graph" model="ir.ui.view">
        <field name="name">healthcare.disease.registry.graph</field>
        <field name="model">healthcare.disease.registry</field>
        <field name="arch" type="xml">
            <graph string="Registry Risk Distribution" type="bar">
                <field name="risk_level"/>
            </graph>
        </field>
    </record>

    <record id="view_healthcare_disease_registry_pivot" model="ir.ui.view">
        <field name="name">healthcare.disease.registry.pivot</field>
        <field name="model">healthcare.disease.registry</field>
        <field name="arch" type="xml">
            <pivot string="Disease Programme KPIs">
                <field name="disease_id" type="row"/>
                <field name="risk_level" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="action_healthcare_disease_type" model="ir.actions.act_window">
        <field name="name">Disease Types</field>
        <field name="res_model">healthcare.disease.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_healthcare_disease_registry" model="ir.actions.act_window">
        <field name="name">Chronic Disease Registry</field>
        <field name="res_model">healthcare.disease.registry</field>
        <field name="view_mode">list,graph,pivot,form</field>
    </record>

    <record id="action_healthcare_care_gaps" model="ir.actions.act_window">
        <field name="name">Care Gaps</field>
        <field name="res_model">healthcare.disease.registry</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('compliance_state', 'in', ['at_risk', 'overdue'])]</field>
    </record>
</odoo>
