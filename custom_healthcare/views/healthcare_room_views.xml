<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_healthcare_room_list" model="ir.ui.view">
        <field name="name">healthcare.room.list</field>
        <field name="model">healthcare.room</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="ward_id"/>
                <field name="practice_id"/>
                <field name="room_type"/>
                <field name="bed_count"/>
                <field name="available_bed_count"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_healthcare_room_form" model="ir.ui.view">
        <field name="name">healthcare.room.form</field>
        <field name="model">healthcare.room</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_beds" type="object" class="oe_stat_button" icon="fa-bed">
                            <field name="bed_count" widget="statinfo" string="Beds"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Room Number"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="ward_id"/>
                            <field name="practice_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="room_type"/>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_healthcare_room_search" model="ir.ui.view">
        <field name="name">healthcare.room.search</field>
        <field name="model">healthcare.room</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="ward_id"/>
                <field name="practice_id"/>
                <group>
                    <filter string="Ward" name="group_ward" context="{'group_by': 'ward_id'}"/>
                    <filter string="Room Type" name="group_type" context="{'group_by': 'room_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_healthcare_room" model="ir.actions.act_window">
        <field name="name">Rooms</field>
        <field name="res_model">healthcare.room</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
