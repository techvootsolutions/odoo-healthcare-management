<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_healthcare" model="ir.module.category">
        <field name="name">Healthcare</field>
        <field name="sequence">25</field>
    </record>

    <record id="res_groups_privilege_healthcare" model="res.groups.privilege">
        <field name="name">Healthcare</field>
        <field name="sequence">25</field>
        <field name="category_id" ref="module_category_healthcare"/>
    </record>

    <record id="group_healthcare_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_healthcare"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_healthcare_coordinator" model="res.groups">
        <field name="name">Care Coordinator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_healthcare"/>
        <field name="implied_ids" eval="[(4, ref('group_healthcare_user'))]"/>
    </record>

    <record id="group_healthcare_gp" model="res.groups">
        <field name="name">GP / Clinician</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_healthcare"/>
        <field name="implied_ids" eval="[(4, ref('group_healthcare_user'))]"/>
    </record>

    <record id="group_healthcare_manager" model="res.groups">
        <field name="name">Ops / Clinical Manager</field>
        <field name="sequence">40</field>
        <field name="privilege_id" ref="res_groups_privilege_healthcare"/>
        <field name="implied_ids" eval="[(4, ref('group_healthcare_coordinator')), (4, ref('group_healthcare_gp'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_healthcare_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">50</field>
        <field name="privilege_id" ref="res_groups_privilege_healthcare"/>
        <field name="implied_ids" eval="[(4, ref('group_healthcare_manager'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>
</odoo>
